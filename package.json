{
  "name": "dsh-image-window",
  "version": "0.1.0",
  "private": true,
  "description": "DSH 图片滑动窗口：每个 agent 步骤请求前，把最近 N 个 assistant 步骤之外的图片块标记 offloaded（占位符带只读路径，可 read_image 读回），治理 computer-use 截图在上下文里的无限累积",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    }
  },
  "license": "MIT"
}
